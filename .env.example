# Required for Gemini-powered features. Leave blank to disable AI generation.
GEMINI_API_KEY=

# Canonical public URL used for OAuth callbacks and absolute links.
APP_URL=https://your-telebiz-domain.example

# Google OAuth Web application credentials. Add the callback URL:
# https://your-telebiz-domain.example/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram bot token from BotFather; required to verify Telegram Mini App initData.
TELEGRAM_BOT_TOKEN=

# Use a persistent mounted disk path. The parent directory is created at startup.
# Example for a VPS with a persistent volume:
TELEBIZ_DATABASE_PATH=/var/lib/telebiz/telebiz_store.db

# Demo fixtures are disabled by default and must never be enabled in production.
TELEBIZ_ENABLE_DEMO_SEED=false
